{
  "name": "dsh-desktop-app",
  "productName": "DeepSeek Harness",
  "version": "1.0.0",
  "description": "DeepSeek Harness 桌面应用壳：独立窗口 + 本地服务守护，替代浏览器启动方式",
  "main": "main.js",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --win portable"
  },
  "build": {
    "appId": "com.dsh.desktop",
    "productName": "DeepSeek Harness",
    "electronDist": "node_modules/electron/dist",
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "files": [
      "main.js",
      "preload.js",
      "loading.html",
      "assets/**/*"
    ],
    "extraResources": [
      {
        "from": "config.json",
        "to": "config.json"
      },
      {
        "from": "scripts",
        "to": "scripts"
      }
    ],
    "win": {
      "signExecutable": false,
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/app.ico"
    },
    "portable": {
      "artifactName": "DeepSeek-Harness-${version}-portable.exe"
    },
    "npmRebuild": false,
    "electronLanguages": [
      "zh-CN",
      "en-US"
    ]
  },
  "devDependencies": {
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3",
    "pnpm": "^11.7.0"
  }
}
